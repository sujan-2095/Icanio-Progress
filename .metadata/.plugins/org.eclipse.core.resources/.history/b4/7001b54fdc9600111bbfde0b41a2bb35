package Icanio;

public class frequency {

	public static void main(String[] args) {
		String str="Hello world";
		str.toLowerCase();
		for(int i=0;i<str.length()-1;i++) {
			int count=0;
			for(int j=0;i<str.length()-1;i++) {
				if(str.charAt(i)==str.charAt(j)) {
					count++;
				}
				System.out.print(str.charAt(i)+" "+count);
			}
		}

	}

}
